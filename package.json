{
  "name": "lumos",
  "version": "0.1.0",
  "buildNumber": 1,
  "private": true,
  "description": "A low-power macOS wake lease for unfinished work.",
  "license": "UNLICENSED",
  "os": [
    "darwin"
  ],
  "cpu": [
    "arm64"
  ],
  "packageManager": "pnpm@10.33.3",
  "scripts": {
    "dev": "node Scripts/dev.mjs",
    "build": "swift build",
    "build:release": "node Scripts/build-release.mjs",
    "build:release:notarized": "node Scripts/build-release.mjs --notarize",
    "test": "swift test",
    "spike": "./Scripts/run-spike.sh",
    "probe": "swift run lumos-spike",
    "probe:assertions": "./Scripts/verify-assertions.sh",
    "probe:process": "./Scripts/verify-process-tree.sh",
    "clean": "swift package clean"
  }
}
